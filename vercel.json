{
  "version": 2,
  "framework": null,
  "buildCommand": "cd client && npm install && npm run build && cp -r dist/* ../",
  "outputDirectory": ".",
  "functions": {
    "php-backend/api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/php-backend/api/$1.php"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/php-backend/uploads/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

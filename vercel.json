{
  "version": 2,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "{php-backend/**,api/**}"
    }
  },
  "routes": [
    {
      "src": "^/client/(.*)$",
      "status": 404,
      "dest": "/404"
    },
    {
      "src": "^/php-backend/api/(.*)\\.php$",
      "dest": "/api/$1.php"
    },
    {
      "src": "^/php-backend/api/(.*)$",
      "dest": "/api/$1.php"
    },
    {
      "src": "^/api/(.*)\\.php$",
      "dest": "/api/$1.php"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1.php"
    },
    {
      "src": "^/php-backend/uploads/(.*)$",
      "dest": "/api/image.php?file=$1"
    },
    {
      "src": "^/uploads/(.*)$",
      "dest": "/api/image.php?file=$1"
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "^/logo.jpg$",
      "dest": "/logo.jpg"
    },
    {
      "src": "^/favicon.svg$",
      "dest": "/favicon.svg"
    },
    {
      "src": "^/icons.svg$",
      "dest": "/icons.svg"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
